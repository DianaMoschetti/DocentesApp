@page "/puntosporcargo/nuevo"
@using DocentesApp.Shared.DTOs.PuntosPorCargo
@using DocentesApp.Domain.Enums
@using DocentesApp.Blazor.UI.Helpers
@using DocentesApp.Shared.Validators.PuntosPorCargo
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

<PageTitle>Nuevos puntos por cargo</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Nuevos puntos por cargo</h2>
        <button class="btn btn-outline-secondary"
                @onclick='() => Navigation.NavigateTo("puntosporcargo")'>
            Volver
        </button>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <EditForm Model="puntosPorCargoDto" OnSubmit="HandleSubmit">
        <div class="card mb-4">
            <div class="card-header">Datos de puntos por cargo</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Denominación <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="puntosPorCargoDto.Denominacion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var (value, display) in denominaciones)
                            {
                                <option value="@value">@display</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Tipo <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="puntosPorCargoDto.TipoCargo">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var (value, display) in tipos)
                            {
                                <option value="@value">@display</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Puntos base <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="puntosPorCargoDto.PuntosBase" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary"
                    @onclick='() => Navigation.NavigateTo("puntosporcargo")'
                    disabled="@isSaving">
                Cancelar
            </button>
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "Guardando..." : "Guardar")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private CreatePuntosPorCargoDto puntosPorCargoDto = new();
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    private readonly List<(DenominacionCargo Value, string Display)> denominaciones =
        EnumHelper.GetOptions<DenominacionCargo>();
    private readonly List<(TipoCargo Value, string Display)> tipos =
        EnumHelper.GetOptions<TipoCargo>();

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;

        // Validación client-side
        var validator = new CreatePuntosPorCargoDtoValidator();
        var result = await validator.ValidateAsync(puntosPorCargoDto);
        if (!result.IsValid)
        {
            errorMessage = string.Join(" | ", result.Errors.Select(e => e.ErrorMessage));
            return;
        }

        try
        {
            isSaving = true;
            await Client.PuntosPorCargoPOSTAsync(puntosPorCargoDto);
            Navigation.NavigateTo("puntosporcargo", new NavigationOptions { ReplaceHistoryEntry = true });
        }
        catch (ApiException ex)
        {
            errorMessage = ex.StatusCode switch
            {
                400 => "Ya existen puntos por cargo con esa combinación.",
                401 => "No tiene permisos para realizar esta acción.",
                403 => "No tiene permisos para realizar esta acción.",
                _ => "Error al guardar. Intentá de nuevo."
            };
        }
        finally
        {
            isSaving = false;
        }
    }
}
