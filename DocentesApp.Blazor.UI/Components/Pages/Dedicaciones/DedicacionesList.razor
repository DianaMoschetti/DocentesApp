@* [Diana desde v4.0 OBSOLETO] Esta página fue reemplazada por atributos en DetalleDesignacion *@
@page "/dedicaciones"
@using DocentesApp.Shared.DTOs.Dedicaciones
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

<PageTitle>Dedicaciones</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dedicaciones</h2>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="btn btn-primary"
                        @onclick='() => Navigation.NavigateTo("dedicaciones/nuevo")'>
                    + Nueva dedicación
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (isLoading)
    {
        <p>Cargando...</p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (!dedicaciones.Any())
    {
        <div class="alert alert-info">No hay dedicaciones cargadas todavía.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Horas</th>
                    <th>Cantidad dedicación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dedicacion in dedicaciones)
                {
                    <tr>
                        <td>@dedicacion.Descripcion</td>
                        <td>@dedicacion.CantidadHoras</td>
                        <td>@dedicacion.CantidadDedicacion</td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmarEliminar(dedicacion)">
                                        Eliminar
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (dedicacionAEliminar != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                </div>
                <div class="modal-body">
                    <p>¿Estás segura que querés eliminar la dedicación <strong>@dedicacionAEliminar.Descripcion</strong>?</p>
                    @if (deleteErrorMessage != null)
                    {
                        <div class="alert alert-danger">@deleteErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <button class="btn btn-secondary"
                                    @onclick="CancelarEliminar"
                                    disabled="@isDeleting">
                                Cancelar
                            </button>
                            <button class="btn btn-danger"
                                    @onclick="EjecutarEliminar"
                                    disabled="@isDeleting">
                                @(isDeleting ? "Eliminando..." : "Eliminar")
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ICollection<ListDedicacionDto> dedicaciones = new List<ListDedicacionDto>();
    private bool isLoading = true;
    private string? errorMessage;

    private ListDedicacionDto? dedicacionAEliminar;
    private bool isDeleting;
    private string? deleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarDedicaciones();
    }

    private async Task CargarDedicaciones()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            dedicaciones = await Client.DedicacionesAllAsync();
        }
        catch (ApiException)
        {
            errorMessage = "Error al cargar las dedicaciones.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmarEliminar(ListDedicacionDto dedicacion)
    {
        dedicacionAEliminar = dedicacion;
        deleteErrorMessage = null;
    }

    private void CancelarEliminar()
    {
        dedicacionAEliminar = null;
        deleteErrorMessage = null;
    }

    private async Task EjecutarEliminar()
    {
        if (dedicacionAEliminar == null) return;

        try
        {
            isDeleting = true;
            deleteErrorMessage = null;
            await Client.DedicacionesDELETEAsync(dedicacionAEliminar.Id);
            dedicacionAEliminar = null;
            await CargarDedicaciones();
        }
        catch (ApiException ex)
        {
            deleteErrorMessage = ex.StatusCode switch
            {
                409 => "No se puede eliminar la dedicación porque tiene designaciones asociadas.",
                404 => "La dedicación no existe.",
                _ => "Error al eliminar la dedicación."
            };
        }
        finally
        {
            isDeleting = false;
        }
    }
}