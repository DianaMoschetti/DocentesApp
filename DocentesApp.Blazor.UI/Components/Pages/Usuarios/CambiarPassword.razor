@page "/cambiar-password"
@using DocentesApp.Shared.DTOs.Usuarios
@using DocentesApp.Shared.Validators.Usuarios
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

@* Cualquier usuario logueado. Al cambiar la contraseña la API cambia el security stamp (el token actual
   deja de valer) y devuelve un token nuevo: se renueva la cookie con /auth/signin, igual que en el login. *@

<PageTitle>Cambiar mi contraseña</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Cambiar mi contraseña</h2>

    <div class="card">
        <div class="card-body">
            @if (errorMessage != null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="dto" OnSubmit="HandleSubmit">
                <div class="mb-3">
                    <label class="form-label">Contraseña actual</label>
                    <InputText type="password" class="form-control" @bind-Value="dto.PasswordActual" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña nueva</label>
                    <InputText type="password" class="form-control" @bind-Value="dto.PasswordNueva" autocomplete="new-password" />
                    <div class="form-text">Al menos 6 caracteres, con un número y una minúscula.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Repetir contraseña nueva</label>
                    <InputText type="password" class="form-control" @bind-Value="confirmacion" autocomplete="new-password" />
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Cambiar contraseña")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CambiarMiPasswordDto dto = new();
    private string confirmacion = string.Empty;
    private bool isSaving;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        errorMessage = null;

        // mismas reglas que valida la API
        var validacion = await new CambiarMiPasswordDtoValidator().ValidateAsync(dto);
        if (!validacion.IsValid)
        {
            errorMessage = string.Join(" | ", validacion.Errors.Select(e => e.ErrorMessage));
            return;
        }
        if (dto.PasswordNueva != confirmacion)
        {
            errorMessage = "Las contraseñas nuevas no coinciden.";
            return;
        }

        try
        {
            isSaving = true;
            var nuevaSesion = await Client.CambiarPasswordAsync(dto);

            // el token viejo ya no vale: se vuelve a firmar la cookie con el nuevo (redirige al inicio)
            Navigation.NavigateTo($"/auth/signin?token={Uri.EscapeDataString(nuevaSesion.Token)}", forceLoad: true);
        }
        catch (ApiException ex)
        {
            errorMessage = ApiErrorHelper.GetMessage(ex); // 400: contraseña actual incorrecta o nueva inválida
            isSaving = false;
        }
        catch (Exception)
        {
            errorMessage = "Error al cambiar la contraseña. Intentá de nuevo.";
            isSaving = false;
        }
    }
}
