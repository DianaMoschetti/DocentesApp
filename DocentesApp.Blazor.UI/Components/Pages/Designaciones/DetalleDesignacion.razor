@page "/designaciones/{Id:int}"
@using DocentesApp.Shared.DTOs.Designaciones
@using DocentesApp.Domain.Enums
@using DocentesApp.Blazor.UI.Helpers
@using DocentesApp.Blazor.UI.Components.Auditoria
@using DocentesApp.Shared.DTOs.Auditoria
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

<PageTitle>Detalle Designación</PageTitle>

<div class="container mt-4">

    @if (isLoading)
    {
        <p>Cargando...</p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (designacion != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                @designacion.NombreCompletoDocente
                @if (designacion.EsVigente)
                {
                    <span class="badge bg-success">Vigente</span>
                }
                else
                {
                    <span class="badge bg-secondary">Finalizada</span>
                }
            </h2>
            <div>
                <AuthorizeView Policy="@Politicas.PuedeEditar">
                    <Authorized>
                        <button class="btn btn-outline-secondary me-2"
                                @onclick='() => Navigation.NavigateTo($"designaciones/{Id}/editar")'>
                            Editar
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-outline-secondary"
                        @onclick='() => Navigation.NavigateTo("designaciones")'>
                    Volver al listado
                </button>
            </div>
        </div>

        @* Pestaña "Historial" (auditoría): solo Administrador; se carga recién al abrirla y queda cargada al volver a "Datos" *@
        <AuthorizeView Policy="@Politicas.EsAdministrador">
            <Authorized>
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(tabActiva == TabDatos ? "active" : "")" @onclick="() => tabActiva = TabDatos">
                            Datos
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(tabActiva == TabHistorial ? "active" : "")" @onclick="AbrirHistorial">
                            Historial
                        </button>
                    </li>
                </ul>
                @if (historialAbierto)
                {
                    <div class="@(tabActiva == TabHistorial ? "" : "d-none")">
                        <HistorialTabla CargarPagina="CargarHistorial"
                                        MensajeVacio="No hay cambios registrados para esta designación." />
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        @if (tabActiva == TabDatos)
        {
            <div class="card mb-4">
                <div class="card-header">Datos de la designación</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Docente</dt>
                        <dd class="col-sm-9">@designacion.NombreCompletoDocente</dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">@EnumHelper.GetDisplay(designacion.EstadoDesignacion)</dd>

                        <dt class="col-sm-3">Fecha de alta</dt>
                        <dd class="col-sm-9">@designacion.FechaInicio.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Fecha de baja</dt>
                        <dd class="col-sm-9">@(designacion.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</dd>

                        <dt class="col-sm-3">Nro. Resolución</dt>
                        <dd class="col-sm-9">@(designacion.NroResolucion ?? "-")</dd>

                        <dt class="col-sm-3">Nro. Nota</dt>
                        <dd class="col-sm-9">@(designacion.NroNota ?? "-")</dd>

                        <dt class="col-sm-3">Total de puntos</dt>
                        <dd class="col-sm-9">@designacion.TotalPuntos.ToString("0.##")</dd>

                        <dt class="col-sm-3">Observaciones</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(designacion.Observaciones) ? "-" : designacion.Observaciones)</dd>
                    </dl>
                </div>
            </div>

            @* v5: un bloque por cargo; los puntos son del cargo (se cuentan una vez) y las actividades solo se listan *@
            <h4 class="mb-3">Cargos</h4>
            @if (!designacion.Cargos.Any())
            {
                <p class="text-muted">Sin cargos cargados.</p>
            }
            @foreach (var cargo in designacion.Cargos)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@cargo.CargoTexto</strong>
                            — @EnumHelper.GetDisplay(cargo.Condicion)
                            — @cargo.DedicacionTexto
                            — @(cargo.NombreUdb ?? "-")
                            @if (cargo.EnLicencia)
                            {
                                <span class="badge bg-warning text-dark ms-2">En licencia</span>
                            }
                        </span>
                        <span><strong>@cargo.Puntos.ToString("0.##")</strong> puntos</span>
                    </div>
                    <div class="card-body">
                        @if (cargo.ReemplazaACargoId.HasValue)
                        {
                            <p class="mb-2"><strong>Reemplaza a:</strong> @(cargo.ReemplazaADescripcion ?? $"cargo {cargo.ReemplazaACargoId}")</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(cargo.Observaciones))
                        {
                            <p class="mb-2"><strong>Observaciones:</strong> @cargo.Observaciones</p>
                        }

                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Actividad</th>
                                    <th>Asignatura</th>
                                    <th>Curso</th>
                                    <th>Horario</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in cargo.Actividades)
                                {
                                    <tr>
                                        <td>@EnumHelper.GetDisplay(act.Especificacion)</td>
                                        <td>@(act.NombreAsignatura ?? "-")</td>
                                        <td>@(act.DescripcionCurso ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(act.Horario) ? "-" : act.Horario)</td>
                                        <td>@(string.IsNullOrWhiteSpace(act.Observaciones) ? "-" : act.Observaciones)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        } @* fin pestaña Datos *@
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private DesignacionDto? designacion;
    private bool isLoading = true;
    private string? errorMessage;

    // Pestañas: "Datos" para todos; "Historial" solo la ve el Administrador
    private const string TabDatos = "datos";
    private const string TabHistorial = "historial";
    private string tabActiva = TabDatos;
    private bool historialAbierto;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDesignacion();
    }

    private void AbrirHistorial()
    {
        tabActiva = TabHistorial;
        historialAbierto = true; // la primera vez monta HistorialTabla, que trae la página 1
    }

    private Task<PaginaHistorialCambioDto> CargarHistorial(int pagina, int tamanioPagina) =>
        Client.HistorialDesignacionAsync(Id, pagina, tamanioPagina);

    private async Task CargarDesignacion()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            // Otra designación: vuelve a "Datos" y el historial se carga de nuevo al abrirlo
            tabActiva = TabDatos;
            historialAbierto = false;
            designacion = await Client.DesignacionesGETAsync(Id);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.StatusCode == 404
                ? "No se encontró la designación."
                : "Error al cargar la designación.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
