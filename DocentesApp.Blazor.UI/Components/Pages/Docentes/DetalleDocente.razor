@page "/docentes/{Id:int}"
@using DocentesApp.Shared.DTOs.Docentes
@using DocentesApp.Shared.DTOs.Designaciones
@using DocentesApp.Domain.Enums
@using DocentesApp.Blazor.UI.Helpers
@using DocentesApp.Blazor.UI.Components.Auditoria
@using DocentesApp.Shared.DTOs.Auditoria
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

<PageTitle>Detalle Docente</PageTitle>

<div class="container mt-4">

    @if (isLoading)
    {
        <p>Cargando...</p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (docente != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@docente.NombreCompleto</h2>
            <div>
                @* [Diana desde v4.0 OBSOLETO] roles Admin/User reemplazados por políticas: <AuthorizeView Roles="Admin"> *@
                <AuthorizeView Policy="@Politicas.PuedeEditar">
                    <Authorized>
                        <button class="btn btn-outline-secondary me-2"
                                @onclick='() => Navigation.NavigateTo($"docentes/{Id}/editar")'>
                            Editar
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-outline-secondary"
                        @onclick='() => Navigation.NavigateTo("docentes")'>
                    Volver
                </button>
            </div>
        </div>

        @* Pestaña "Historial" (auditoría): solo Administrador; se carga recién al abrirla y queda cargada al volver a "Datos" *@
        <AuthorizeView Policy="@Politicas.EsAdministrador">
            <Authorized>
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(tabActiva == TabDatos ? "active" : "")" @onclick="() => tabActiva = TabDatos">
                            Datos
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(tabActiva == TabHistorial ? "active" : "")" @onclick="AbrirHistorial">
                            Historial
                        </button>
                    </li>
                </ul>
                @if (historialAbierto)
                {
                    <div class="@(tabActiva == TabHistorial ? "" : "d-none")">
                        <HistorialTabla CargarPagina="CargarHistorial"
                                        MensajeVacio="No hay cambios registrados para este docente." />
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        @if (tabActiva == TabDatos)
        {
        <div class="card mb-4">
            <div class="card-header">Datos personales</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Legajo</label>
                        @* [Diana desde v4.0 OBSOLETO] el legajo es opcional (v5): "-" si no tiene
                        <p>@docente.Legajo</p> *@
                        <p>@(docente.Legajo?.ToString() ?? "-")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">DNI</label>
                        <p>@(docente.Dni ?? "-")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Nombre</label>
                        <p>@docente.Nombre</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Apellido</label>
                        <p>@docente.Apellido</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Fecha de nacimiento</label>
                        <p>@(docente.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Contacto</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Email</label>
                        <p>@(docente.Email ?? "-")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Email alternativo</label>
                        <p>@(docente.EmailAlternativo ?? "-")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Celular</label>
                        <p>@(docente.Celular ?? "-")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Dirección</label>
                        <p>@(docente.Direccion ?? "-")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Académico</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="fw-bold">Máximo nivel académico</label>
                        <p>
                            @(docente.MaxNivelAcademico.HasValue
                                                    ? EnumHelper.GetDisplay(docente.MaxNivelAcademico.Value)
                                                    : "-")
                    </p>
                </div>
            </div>
        </div>
    </div>

        <div class="card mb-4">
            <div class="card-header">Observaciones</div>
            <div class="card-body">
                <p>@(string.IsNullOrWhiteSpace(docente.Observaciones) ? "-" : docente.Observaciones)</p>
            </div>
        </div>

        @* [Diana desde v4.0 OBSOLETO] placeholder: nunca se cargaban las designaciones del docente
        <div class="card mb-4">
            <div class="card-header">Designaciones</div>
            <div class="card-body">
                <p class="text-muted">Próximamente disponible.</p>
            </div>
        </div>
        *@

        @* v5: una card por designación (cabecera) con la tabla de sus cargos, como DetalleDesignacion *@
        <h4 class="mb-3">Designaciones</h4>
        @if (designacionesError != null)
        {
            <div class="alert alert-warning">@designacionesError</div>
        }
        else if (!designaciones.Any())
        {
            <p class="text-muted">El docente no tiene designaciones.</p>
        }
        @foreach (var des in designaciones)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        @if (des.EsVigente)
                        {
                            <span class="badge bg-success me-2">Vigente</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary me-2">Finalizada</span>
                        }
                        @des.FechaInicio.ToString("dd/MM/yyyy") — @(des.FechaFin?.ToString("dd/MM/yyyy") ?? "sin fecha de baja")
                        — @EnumHelper.GetDisplay(des.EstadoDesignacion)
                        — Res. @(des.NroResolucion ?? "-")
                    </span>
                    <span>
                        <strong>@des.TotalPuntos.ToString("0.##")</strong> puntos
                        <button class="btn btn-sm btn-outline-primary ms-2"
                                @onclick='() => Navigation.NavigateTo($"designaciones/{des.Id}")'>
                            Ver
                        </button>
                    </span>
                </div>
                <div class="card-body">
                    @if (!des.Cargos.Any())
                    {
                        <p class="text-muted mb-0">Sin cargos cargados.</p>
                    }
                    else
                    {
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Cargo</th>
                                    <th>Condición</th>
                                    <th>Dedicación</th>
                                    <th>UDB</th>
                                    <th>Puntos</th>
                                    <th>En licencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cargo in des.Cargos)
                                {
                                    <tr>
                                        <td>@cargo.CargoTexto</td>
                                        <td>@EnumHelper.GetDisplay(cargo.Condicion)</td>
                                        <td>@cargo.DedicacionTexto</td>
                                        <td>@(cargo.NombreUdb ?? "-")</td>
                                        <td>@cargo.Puntos.ToString("0.##")</td>
                                        <td>
                                            @if (cargo.EnLicencia)
                                            {
                                                <span class="badge bg-warning text-dark">En licencia</span>
                                            }
                                            else
                                            {
                                                <span>No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        } @* fin pestaña Datos *@
        }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private DocenteDto? docente;
    private ICollection<DesignacionDto> designaciones = new List<DesignacionDto>(); // cabecera + cargos
    private string? designacionesError;
    private bool isLoading = true;
    private string? errorMessage;

    // Pestañas: "Datos" para todos; "Historial" solo la ve el Administrador
    private const string TabDatos = "datos";
    private const string TabHistorial = "historial";
    private string tabActiva = TabDatos;
    private bool historialAbierto;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDocente();
    }

    private async Task CargarDocente()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            // Otro docente: vuelve a "Datos" y el historial se carga de nuevo al abrirlo
            tabActiva = TabDatos;
            historialAbierto = false;
            docente = await Client.DocentesGETAsync(Id);
            await CargarDesignaciones();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.StatusCode == 404
                ? "No se encontró el docente."
                : "Error al cargar el docente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AbrirHistorial()
    {
        tabActiva = TabHistorial;
        historialAbierto = true; // la primera vez monta HistorialTabla, que trae la página 1
    }

    private Task<PaginaHistorialCambioDto> CargarHistorial(int pagina, int tamanioPagina) =>
        Client.HistorialDocenteAsync(Id, pagina, tamanioPagina);

    // Aparte del docente: si fallan las designaciones, los datos del docente se siguen mostrando
    private async Task CargarDesignaciones()
    {
        try
        {
            designacionesError = null;
            designaciones = await Client.DocenteAsync(Id);
        }
        catch (ApiException)
        {
            designaciones = new List<DesignacionDto>();
            designacionesError = "No se pudieron cargar las designaciones del docente.";
        }
    }
}