@page "/docentes"
@using DocentesApp.Shared.DTOs.Docentes
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Docentes</PageTitle>

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2> Docentes</h2>
        </div>
        <div class="col text-end">
            @* [Diana desde v4.0 OBSOLETO] roles Admin/User reemplazados por políticas: <AuthorizeView Roles="Admin"> *@
            <AuthorizeView Policy="@Politicas.PuedeEditar">
                <Authorized>
                    <button class="btn btn-primary"
                            @onclick='() => Navigation.NavigateTo("docentes/nuevo")'>
                        + Nuevo Docente
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (_isLoading)
    {
        <p>Cargando...</p>
    }
    else if (_errorMessage != null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    else if (!_docentes.Any())
    {
        <div class="alert alert-info">No hay docentes registrados.</div>
    }
    else
    {
        @* Búsqueda en el cliente (la lista viene completa, sin paginado): apellido, nombre, legajo o DNI,
           sin distinguir mayúsculas ni acentos, con debounce de 300 ms *@
        <div class="row mb-3">
            <div class="col-md-6">
                <input type="search" class="form-control"
                       placeholder="Buscar por apellido, nombre, legajo o DNI..."
                       @bind="_busqueda" @bind:event="oninput" @bind:after="OnBusquedaCambiada" />
            </div>
            <div class="col-md-6 text-end text-muted align-self-center">
                Mostrando @_docentesFiltrados.Count de @_docentes.Count
            </div>
        </div>

        @if (!_docentesFiltrados.Any())
        {
            <div class="alert alert-info">Ningún docente coincide con la búsqueda.</div>
        }
        else
        {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Legajo</th>
                    <th>Nombre completo</th>
                    <th>DNI</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* [Diana desde v4.0 OBSOLETO] se recorre la lista filtrada por la búsqueda
                @foreach (var docente in _docentes) *@
                @foreach (var docente in _docentesFiltrados)
                {
                    <tr>
                        @* [Diana desde v4.0 OBSOLETO] el legajo es opcional (v5): "-" si no tiene
                        <td>@docente.Legajo</td> *@
                        <td>@(docente.Legajo?.ToString() ?? "-")</td>
                        <td>@docente.NombreCompleto</td>
                        <td>@docente.Dni</td>
                        <td>@docente.Email</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick="@(() => Navigation.NavigateTo($"docentes/{docente.Id}"))">
                                Ver
                            </button>
                            @* [Diana desde v4.0 OBSOLETO] roles Admin/User reemplazados por políticas: <AuthorizeView Roles="Admin"> *@
                            <AuthorizeView Policy="@Politicas.PuedeEditar">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            @onclick="@(() => Navigation.NavigateTo($"docentes/{docente.Id}/editar"))">
                                        Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="@(() => ConfirmarEliminar(docente.Id, docente.NombreCompleto))">
                                        Eliminar
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }

    @if (_mostrarConfirmacion)
    {
        <div class="modal d-block" style="background:rgba(0,0,0,0.5)">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                    </div>
                    <div class="modal-body">
                        ¿Estás segura que querés eliminar a <strong>@_nombreAEliminar</strong>?
                    </div>
                    <div class="modal-footer">
                        @* [Diana desde v4.0 OBSOLETO] roles Admin/User reemplazados por políticas: <AuthorizeView Roles="Admin"> *@
                        <AuthorizeView Policy="@Politicas.PuedeEditar">
                            <Authorized>
                                <button class="btn btn-secondary"
                                        @onclick="() => _mostrarConfirmacion = false">
                                    Cancelar
                                </button>
                                <button class="btn btn-danger" @onclick="EliminarDocente">
                                    Eliminar
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ICollection<ListDocenteDto> _docentes = new List<ListDocenteDto>();
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _mostrarConfirmacion;
    private int _idAEliminar;
    private string? _nombreAEliminar;

    // Búsqueda: _busqueda es lo que se tipea; el filtro se aplica 300 ms después de la última tecla
    private string _busqueda = string.Empty;
    private List<ListDocenteDto> _docentesFiltrados = new();
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarDocentes();
    }

    private async Task CargarDocentes()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            // la API ya los devuelve ordenados por Apellido y Nombre (DocenteRepository.GetAllAsync)
            _docentes = await Client.DocentesAllAsync();
            AplicarFiltro();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.StatusCode == 401
                ? "No tenés permisos para ver esta sección."
                : "Error al cargar los docentes. Intentá de nuevo.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnBusquedaCambiada()
    {
        // debounce: cada tecla cancela la espera anterior
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return; // llegó otra tecla antes de los 300 ms
        }

        AplicarFiltro();
    }

    // Cada palabra tipeada tiene que aparecer en apellido, nombre, legajo o DNI ("martinez ana" encuentra "Martínez, Ana")
    private void AplicarFiltro()
    {
        var terminos = Normalizar(_busqueda)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (terminos.Length == 0)
        {
            _docentesFiltrados = _docentes.ToList();
            return;
        }

        _docentesFiltrados = _docentes
            .Where(d =>
            {
                var texto = Normalizar($"{d.Apellido} {d.Nombre} {d.Legajo} {d.Dni}");
                return terminos.All(t => texto.Contains(t));
            })
            .ToList();
    }

    // Minúsculas y sin acentos: "Martínez" -> "martinez"
    private static string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return string.Empty;

        var descompuesto = texto.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(descompuesto.Length);
        foreach (var c in descompuesto)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }

    private void ConfirmarEliminar(int id, string? nombre)
    {
        _idAEliminar = id;
        _nombreAEliminar = nombre;
        _mostrarConfirmacion = true;
    }

    private async Task EliminarDocente()
    {
        try
        {
            await Client.DocentesDELETEAsync(_idAEliminar);
            _mostrarConfirmacion = false;
            await CargarDocentes();
        }
        catch (ApiException ex)
        {
            _mostrarConfirmacion = false;
            _errorMessage = ex.StatusCode == 409
                ? "No se puede eliminar el docente porque tiene designaciones asociadas."
                : "Error al eliminar el docente.";
        }
    }
}