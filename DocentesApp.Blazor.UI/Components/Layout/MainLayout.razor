@inherits LayoutComponentBase
@* [Diana desde v4.0 OBSOLETO]
@implements IDisposable
@inject NavigationManager Navigation
*@

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        @* [Diana desde v4.0 OBSOLETO] — MainLayout es SSR estático (solo las páginas son InteractiveServer),
           así que este aviso y el chequeo de @code nunca corrían: el layout se descarta después del render.
           Se movió a SessionExpirationWatcher, que sí es interactivo.
        @if (_mostrarAvisoExpiracion)
        {
            <div class="alert alert-warning alert-dismissible fade show m-3" role="alert">
                Tu sesión expira en 5 minutos. Guardá tu trabajo y volvé a iniciar sesión.
                <button type="button" class="btn-close" aria-label="Close"
                        @onclick="() => _mostrarAvisoExpiracion = false"></button>
            </div>
        }
        *@

        @* Vigila la expiración de sesión (JWT exp, revalidación y 401) y redirige a /auth/signout *@
        <SessionExpirationWatcher @rendermode="InteractiveServer" />

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

