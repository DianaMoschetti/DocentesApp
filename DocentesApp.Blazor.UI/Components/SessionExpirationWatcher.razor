@using System.IdentityModel.Tokens.Jwt
@using Microsoft.Extensions.Configuration
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject SessionExpirationService SessionExpiration
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<SessionExpirationWatcher> Logger

@* Vigila la expiración de la sesión dentro del circuito de Blazor Server.
   Se coloca en MainLayout con @rendermode InteractiveServer (MainLayout es SSR estático,
   por eso el chequeo que estaba en el layout nunca llegaba a correr).
   NO se usa en EmptyLayout / Login para evitar loops de redirección. *@

@* [Diana desde v4.0 OBSOLETO] — aviso viejo de "expira en 5 minutos" (expiración FIJA).
   Reemplazado por el aviso de INACTIVIDAD de más abajo.
@if (_mostrarAvisoExpiracion)
{
    <div class="alert alert-warning alert-dismissible fade show m-3" role="alert">
        Tu sesión expira en 5 minutos. Guardá tu trabajo y volvé a iniciar sesión.
        <button type="button" class="btn-close" aria-label="Close"
                @onclick="() => _mostrarAvisoExpiracion = false"></button>
    </div>
}
*@

@* Aviso de cierre por INACTIVIDAD, con cuenta regresiva y botón para seguir conectado. *@
@if (_mostrarAvisoInactividad)
{
    <div class="alert alert-warning fade show m-3" role="alert">
        Tu sesión se cerrará por inactividad en @_segundosRestantes segundos.
        <button type="button" class="btn btn-sm btn-primary ms-2"
                @onclick="SeguirConectado">Seguir conectado</button>
    </div>
}

@code {
    private const string SignOutUrl = "/auth/signout?expired=true";

    // [Diana desde v4.0 OBSOLETO] — antelación fija de 5 min del aviso previo al vencimiento del JWT.
    // private static readonly TimeSpan TiempoAvisoExpiracion = TimeSpan.FromMinutes(5);

    // Timeout por inactividad y antelación del aviso (configurables, sin números mágicos).
    private TimeSpan _idleTimeout;
    private TimeSpan _idleWarning;

    private Timer? _timerExpiracion;    // tope ABSOLUTO (exp del JWT)
    // [Diana desde v4.0 OBSOLETO] — timer del aviso fijo de 5 min.
    // private Timer? _timerAviso;
    private Timer? _timerIdle;          // cierre por inactividad
    private Timer? _timerIdleAviso;     // disparo del aviso de inactividad
    private Timer? _timerCuenta;        // cuenta regresiva del aviso (cada 1s)

    private bool _suscripto;
    private bool _redirigiendo;
    // [Diana desde v4.0 OBSOLETO] — flag del aviso fijo de 5 min.
    // private bool _mostrarAvisoExpiracion;
    private bool _mostrarAvisoInactividad;
    private int _segundosRestantes;

    private IJSObjectReference? _module;
    private DotNetObjectReference<SessionExpirationWatcher>? _selfRef;

    // Se arranca en OnAfterRender (y no en OnInitialized) para no correr durante el prerender SSR:
    // ahí no hay circuito y NavigateTo/timers/JS no tienen sentido.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _idleTimeout = TimeSpan.FromMinutes(Configuration.GetValue("Session:IdleTimeoutMinutes", 15));
        _idleWarning = TimeSpan.FromSeconds(Configuration.GetValue("Session:IdleWarningSeconds", 60));

        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        SessionExpiration.SessionExpired += OnSessionExpired;
        _suscripto = true;

        // Por si el 401 llegó antes de que este componente se suscribiera.
        if (SessionExpiration.IsExpired)
        {
            OnSessionExpired();
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return; // páginas anónimas: no hay sesión que vigilar

        var expiracion = ObtenerExpiracion(authState);
        if (expiracion == null)
            return;

        var restante = expiracion.Value - DateTimeOffset.UtcNow;
        if (restante <= TimeSpan.Zero)
        {
            OnSessionExpired();
            return;
        }

        // Timer que redirige justo al vencer el JWT (tope ABSOLUTO), sin esperar a la próxima revalidación.
        _timerExpiracion = new Timer(_ => OnSessionExpired(), null, Clamp(restante), Timeout.InfiniteTimeSpan);

        // [Diana desde v4.0 OBSOLETO] — programación del aviso fijo de 5 min antes del vencimiento.
        // var hastaAviso = restante - TiempoAvisoExpiracion;
        // if (hastaAviso <= TimeSpan.Zero)
        // {
        //     _mostrarAvisoExpiracion = true;
        //     StateHasChanged();
        // }
        // else
        // {
        //     _timerAviso = new Timer(_ => _ = InvokeAsync(() =>
        //     {
        //         _mostrarAvisoExpiracion = true;
        //         StateHasChanged();
        //     }), null, Clamp(hastaAviso), Timeout.InfiniteTimeSpan);
        // }

        // Detección de actividad (JS): cada actividad local o de otra pestaña llama a OnActivity.
        // [Diana desde v4.0 OBSOLETO] — sin manejo de errores: si el import o init fallaban, la
        // excepción cortaba este método antes de ReiniciarIdle (sin timers de idle) y tiraba el circuito.
        // _selfRef = DotNetObjectReference.Create(this);
        // _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sessionActivity.js");
        // await _module.InvokeVoidAsync("init", _selfRef);
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModuleUrl());
            await _module.InvokeVoidAsync("init", _selfRef);
        }
        catch (JSDisconnectedException)
        {
            return; // el circuito ya se cerró
        }
        catch (JSException ex)
        {
            // Sin JS no hay detección de actividad, pero el cierre por inactividad tiene que
            // seguir funcionando: se loguea y se programan los timers igual.
            Logger.LogWarning(ex, "No se pudo inicializar sessionActivity.js");
        }

        // Arranca la cuenta de inactividad.
        ReiniciarIdle();
    }

    // URL del módulo con versión = fecha de modificación del archivo. UseStaticFiles no manda
    // Cache-Control, así que el navegador puede reusar una versión vieja del módulo en caché
    // (pasó: el cacheado no tenía setModoAviso y el modo aviso nunca se activaba).
    // Con ?v=... cada cambio del archivo fuerza una descarga nueva.
    private string ModuleUrl()
    {
        const string path = "js/sessionActivity.js";
        var file = Env.WebRootFileProvider.GetFileInfo(path);
        return file.Exists
            ? $"./{path}?v={file.LastModified.ToUnixTimeSeconds()}"
            : $"./{path}";
    }

    // Lo llama sessionActivity.js ante actividad local o de otras pestañas.
    [JSInvokable]
    public void OnActivity()
    {
        _ = InvokeAsync(ReiniciarIdle);
    }

    // Lo llama sessionActivity.js si el keepalive devuelve 401 (sesión ya caída en el server):
    // mismo camino que los demás signos de expiración.
    [JSInvokable]
    public void OnUnauthorized()
    {
        _ = InvokeAsync(Redirigir);
    }

    // Reinicia la cuenta de inactividad: oculta el aviso y reprograma aviso + cierre.
    // NO toca el timer absoluto del JWT (ese no se renueva con actividad).
    private void ReiniciarIdle()
    {
        if (_redirigiendo)
            return;

        _timerIdle?.Dispose();
        _timerIdleAviso?.Dispose();
        _timerCuenta?.Dispose();
        _timerCuenta = null;

        if (_mostrarAvisoInactividad)
        {
            _mostrarAvisoInactividad = false;
            // Salimos del modo aviso: la actividad pasiva local vuelve a contar.
            _ = SetModoAvisoAsync(false);
            StateHasChanged();
        }

        var hastaAviso = _idleTimeout - _idleWarning;
        if (hastaAviso < TimeSpan.Zero)
            hastaAviso = TimeSpan.Zero;

        _timerIdleAviso = new Timer(_ => _ = InvokeAsync(MostrarAvisoInactividad),
            null, hastaAviso, Timeout.InfiniteTimeSpan);
        _timerIdle = new Timer(_ => OnIdleTimeout(),
            null, _idleTimeout, Timeout.InfiniteTimeSpan);
    }

    // Muestra el aviso y arranca la cuenta regresiva de 1s.
    private void MostrarAvisoInactividad()
    {
        _mostrarAvisoInactividad = true;
        _segundosRestantes = (int)_idleWarning.TotalSeconds;
        // Entramos en modo aviso: la actividad pasiva local se ignora en JS para que el
        // usuario pueda llegar al botón "Seguir conectado" sin reiniciar el timer.
        _ = SetModoAvisoAsync(true);
        StateHasChanged();

        _timerCuenta = new Timer(_ => _ = InvokeAsync(() =>
        {
            if (_segundosRestantes > 0)
                _segundosRestantes--;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnIdleTimeout()
    {
        _ = InvokeAsync(Redirigir);
    }

    // Botón "Seguir conectado": cuenta como actividad y dispara un keepalive inmediato.
    private async Task SeguirConectado()
    {
        ReiniciarIdle();
        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("forzarActividad"); }
            catch (JSDisconnectedException) { }
            catch (JSException ex) { Logger.LogWarning(ex, "forzarActividad falló"); }
        }
    }

    private static DateTimeOffset? ObtenerExpiracion(AuthenticationState authState)
    {
        var token = authState.User.FindFirst("access_token")?.Value;
        if (string.IsNullOrEmpty(token))
            return null;

        try
        {
            var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);
            return jwt.ValidTo == DateTime.MinValue ? null : new DateTimeOffset(jwt.ValidTo, TimeSpan.Zero);
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    // System.Threading.Timer no acepta más de ~49 días.
    private static TimeSpan Clamp(TimeSpan t) =>
        t > TimeSpan.FromDays(40) ? TimeSpan.FromDays(40) : t;

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            if (state.User.Identity?.IsAuthenticated != true)
                Redirigir();
        });
    }

    // Puede venir del timer, del hilo de la respuesta HTTP (401) o del revalidador.
    private void OnSessionExpired()
    {
        _ = InvokeAsync(Redirigir);
    }

    private void Redirigir()
    {
        if (_redirigiendo)
            return;
        _redirigiendo = true;

        // Salimos del modo aviso (best-effort; el forceLoad recarga la página igual).
        _ = SetModoAvisoAsync(false);

        // /auth/signout borra la cookie y redirige a /login?expired=true.
        Navigation.NavigateTo(SignOutUrl, forceLoad: true);
    }

    // Entra/sale del modo aviso en JS: mientras está activo, la actividad pasiva local
    // no reinicia el timer (ver sessionActivity.js).
    private async Task SetModoAvisoAsync(bool on)
    {
        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("setModoAviso", on); }
            catch (JSDisconnectedException) { }
            // Se llama fire-and-forget: sin este catch un error de JS (p. ej. un módulo viejo
            // sin setModoAviso) se perdía en silencio y el modo aviso nunca se activaba.
            catch (JSException ex) { Logger.LogWarning(ex, "setModoAviso({On}) falló", on); }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_suscripto)
        {
            AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            SessionExpiration.SessionExpired -= OnSessionExpired;
        }
        _timerExpiracion?.Dispose();
        // [Diana desde v4.0 OBSOLETO]
        // _timerAviso?.Dispose();
        _timerIdle?.Dispose();
        _timerIdleAviso?.Dispose();
        _timerCuenta?.Dispose();

        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
