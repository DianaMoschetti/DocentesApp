@page "/reportes/planta-udb"
@using DocentesApp.Shared.DTOs.Reportes
@using DocentesApp.Shared.DTOs.Udbs
@using DocentesApp.Blazor.UI.Services.Base
@inject IClient Client
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClient Client
@inject NavigationManager Navigation

<PageTitle>Reporte — Planta Docente por UDB</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Planta Docente por UDB</h2>
    </div>

    @* Filtro de UDB *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Seleccioná una UDB</label>
                    <select class="form-select" @onchange="OnUdbChanged">
                        <option value="0">-- Seleccionar UDB --</option>
                        @foreach (var udb in udbs)
                        {
                            <option value="@udb.Id">@udb.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100"
                            @onclick="CargarReporte"
                            disabled="@(udbSeleccionada == 0 || isLoading)">
                        @(isLoading ? "Cargando..." : "Ver planta")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @* [Diana desde v4.0 OBSOLETO] tabla v4 (PlantaDocenteReporteDto); reemplazada por las dos vistas v5 de abajo
    @if (planta.Any())
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <strong>@udbs.FirstOrDefault(u => u.Id == udbSeleccionada)?.Nombre</strong>
                    — @planta.Count() docentes activos
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Docente</th>
                            <th>Legajo</th>
                            <th>Categoría</th>
                            <th>Dedicación</th>
                            <th>Especificación</th>
                            <th>Asignatura</th>
                            <th>Puntos</th>
                            <th>Resolución</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in planta)
                        {
                            <tr>
                                <td>@fila.NombreCompleto</td>
                                <td>@fila.Legajo</td>
                                <td>@($"{fila.Denominacion} {fila.TipoCargo} {fila.Condicion}")</td>
                                <td>@($"{fila.CantidadDedicacion} {fila.TipoDedicacion}")</td>
                                <td>@fila.Especificacion</td>
                                <td>@(fila.Asignatura ?? "—")</td>
                                <td>@fila.PuntosAsignados</td>
                                <td>@(fila.NroResolucion ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!isLoading && udbSeleccionada > 0 && hasBuscado)
    {
        <div class="alert alert-info">No hay docentes con designaciones vigentes en esta UDB.</div>
    }
    *@

    @if (porAsignatura != null && porDocente != null && porAsignatura.Filas.Any())
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link @(tabActiva == TabAsignatura ? "active" : "")" @onclick="() => tabActiva = TabAsignatura">
                    Por asignatura
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActiva == TabDocente ? "active" : "")" @onclick="() => tabActiva = TabDocente">
                    Por docente
                </button>
            </li>
        </ul>

        <div class="card border-top-0">
            <div class="card-header">
                <strong>@porAsignatura.NombreUdb</strong>
                — @porAsignatura.Filas.Select(f => f.CargoDesignacionId).Distinct().Count() cargos vigentes
            </div>
            <div class="card-body p-0">
                @if (tabActiva == TabAsignatura)
                {
                    @* Vista por asignatura: una fila de título por sección (gestión, laboratorios e investigación, cada asignatura, otros) *@
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Curso</th>
                                <th>Docente</th>
                                <th>Legajo</th>
                                <th>Cargo</th>
                                <th>Cond.</th>
                                <th>Dedicación</th>
                                <th>Especificación</th>
                                <th>Horario</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ string? seccionActual = null; }
                            @foreach (var fila in porAsignatura.Filas)
                            {
                                if (fila.Seccion != seccionActual)
                                {
                                    seccionActual = fila.Seccion;
                                    <tr class="table-secondary">
                                        <td colspan="9">
                                            <strong>@fila.Seccion</strong>
                                            @if (!string.IsNullOrEmpty(fila.AC) && fila.Seccion == fila.Asignatura)
                                            {
                                                <span> (@fila.AC)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td>@(fila.Curso ?? "—")</td>
                                    <td>@fila.Docente</td>
                                    <td>@(fila.Legajo?.ToString() ?? "-")</td>
                                    <td>
                                        @fila.CargoCorto
                                        @if (fila.EnLicencia)
                                        {
                                            <span class="badge bg-warning text-dark">En licencia</span>
                                        }
                                    </td>
                                    <td>@fila.CondicionCorta</td>
                                    <td>@fila.Dedicacion</td>
                                    <td>@fila.Especificacion</td>
                                    <td>@(fila.Horario ?? "—")</td>
                                    <td>@(fila.Observaciones ?? "")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="8" class="text-end"><strong>Total de puntos</strong></td>
                                <td><strong>@porAsignatura.TotalPuntos</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    @* Vista por docente: los puntos del cargo van solo en su primera fila *@
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Docente</th>
                                <th>Legajo</th>
                                <th>Cargo</th>
                                <th>Cond.</th>
                                <th>Dedicación</th>
                                <th>Especificación</th>
                                <th>Asignatura</th>
                                <th>A/C</th>
                                <th>Curso</th>
                                <th>Horario</th>
                                <th>Observaciones</th>
                                <th>Puntos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in porDocente.Filas)
                            {
                                <tr>
                                    <td>@fila.Docente</td>
                                    <td>@(fila.Legajo?.ToString() ?? "-")</td>
                                    <td>
                                        @fila.CargoCorto
                                        @if (fila.EnLicencia)
                                        {
                                            <span class="badge bg-warning text-dark">En licencia</span>
                                        }
                                    </td>
                                    <td>@fila.CondicionCorta</td>
                                    <td>@fila.Dedicacion</td>
                                    <td>@fila.Especificacion</td>
                                    <td>@(fila.Asignatura ?? "—")</td>
                                    <td>@(fila.AC ?? "")</td>
                                    <td>@(fila.Curso ?? "—")</td>
                                    <td>@(fila.Horario ?? "—")</td>
                                    <td>@(fila.Observaciones ?? "")</td>
                                    <td>@(fila.Puntos == 0 ? "" : fila.Puntos.ToString())</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="11" class="text-end"><strong>Total de puntos</strong></td>
                                <td><strong>@porDocente.TotalPuntos</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        </div>
    }
    else if (!isLoading && udbSeleccionada > 0 && hasBuscado)
    {
        <div class="alert alert-info">No hay docentes con designaciones vigentes en esta UDB.</div>
    }
</div>

@code {
    private ICollection<ListUdbDto> udbs = new List<ListUdbDto>();
    // [Diana desde v4.0 OBSOLETO] reemplazado por las dos vistas v5
    //private IEnumerable<PlantaDocenteReporteDto> planta = new List<PlantaDocenteReporteDto>();
    private const string TabAsignatura = "asignatura";
    private const string TabDocente = "docente";
    private PlantaUdbReporteDto? porAsignatura;
    private PlantaUdbReporteDto? porDocente;
    private string tabActiva = TabAsignatura;
    private int udbSeleccionada;
    private bool isLoading;
    private bool hasBuscado;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            udbs = await Client.UdbsAllAsync();
        }
        catch (ApiException)
        {
            errorMessage = "Error al cargar las UDBs.";
        }
    }

    private void OnUdbChanged(ChangeEventArgs e)
    {
        udbSeleccionada = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        // [Diana desde v4.0 OBSOLETO]
        //planta = new List<PlantaDocenteReporteDto>();
        porAsignatura = null;
        porDocente = null;
        hasBuscado = false;
        errorMessage = null;
    }

    private async Task CargarReporte()
    {
        if (udbSeleccionada == 0) return;

        try
        {
            isLoading = true;
            errorMessage = null;
            // [Diana desde v4.0 OBSOLETO]
            //planta = await Client.UdbAsync(udbSeleccionada);
            var tareaAsignatura = Client.PorAsignaturaAsync(udbSeleccionada);
            var tareaDocente = Client.PorDocenteAsync(udbSeleccionada);
            await Task.WhenAll(tareaAsignatura, tareaDocente);
            porAsignatura = tareaAsignatura.Result;
            porDocente = tareaDocente.Result;
            hasBuscado = true;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.StatusCode == 404
                ? "No se encontró la UDB seleccionada."
                : "Error al cargar el reporte.";
        }
        finally
        {
            isLoading = false;
        }
    }
}